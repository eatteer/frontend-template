{
  "extends": "./tsconfig.app.json",
  // The tests run in Node, so they get its types; the application does not, which keeps a Node API
  // out of code that ships to a browser.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.test.ts", "src/**/*.test.tsx", "test"],
  "exclude": []
}
