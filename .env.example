# Copy to `.env` and adjust. Everything here is compiled into the bundle and readable by anyone who
# loads the page: a VITE_* variable is configuration, never a secret.

# Where backend-template listens. Same site as the dev server (localhost), which the auth cookies'
# SameSite=strict requires.
VITE_API_URL="http://localhost:3000"

# Read only by the end-to-end suite (`npm run test:e2e`), never compiled into the bundle: Vite exposes
# VITE_* variables alone. The administrator backend-template's seed created — its SEED_ADMIN_EMAIL and
# SEED_ADMIN_PASSWORD.
E2E_ADMIN_EMAIL="admin@example.com"
E2E_ADMIN_PASSWORD=""
# Optional: an application already served (the Docker image) to run the suite against, instead of
# the build it serves itself.
# E2E_BASE_URL="http://localhost:8080"
